{
  "name": "signalk-wifish",
  "version": "0.1.0",
  "description": "Raymarine Wi-Fish / Dragonfly Pro Wi-Fi sonar for Signal K: depth, water temperature and a live echogram web app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/devserver.*",
    "public",
    "!public/*.map",
    "tools",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:web": "node web/build.mjs",
    "watch:web": "node web/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "npm run build && node dist/devserver.js --demo",
    "pretest": "npm run typecheck",
    "test": "vitest run",
    "prepack": "npm run build",
    "preprobe": "npm run build:server",
    "probe": "node tools/wifish-probe.mjs",
    "predump": "npm run build:server",
    "dump": "node tools/dump-raw.mjs"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-instruments",
    "sonar",
    "echogram",
    "fishfinder",
    "raymarine",
    "wi-fish",
    "dragonfly",
    "depth"
  ],
  "signalk": {
    "appIcon": "./icon.svg",
    "displayName": "Wi-Fish Sonar",
    "screenshots": [
      "./docs/screenshot.jpg",
      "./docs/screenshot-settings.jpg"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KEGustafsson/signalk-wifish.git"
  },
  "homepage": "https://github.com/KEGustafsson/signalk-wifish#readme",
  "bugs": {
    "url": "https://github.com/KEGustafsson/signalk-wifish/issues"
  },
  "author": "Karl-Erik Gustafsson"
}
